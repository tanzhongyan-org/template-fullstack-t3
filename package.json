{
  "name": "template-fullstack-t3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "dev:setup": "bun run scripts/dev-setup.ts",
    "lint": "biome check .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "storybook": "SKIP_ENV_VALIDATION=1 storybook dev -p 6006",
    "build-storybook": "SKIP_ENV_VALIDATION=1 storybook build -o storybook-static",
    "prepare": "node -e \"const fs=require('node:fs');if(fs.existsSync('.git')&&fs.existsSync('node_modules/lefthook'))require('node:child_process').execSync('lefthook install',{stdio:'inherit'})\"",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "posthog-node": "^5.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@storybook/nextjs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^24.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.37.0",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "lighthouse": "13.6.0",
    "markdownlint-cli2": "0.24.0",
    "postcss": "^8.5.32",
    "shadcn": "^4.23.0",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "overrides": {
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "re2js": "^2.9.1",
    "webpack-dev-middleware": "^8.5.0",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "knip": {
    "next": false,
    "entry": [
      "next.config.js",
      "drizzle.config.ts",
      "scripts/*.{ts,mjs}",
      "src/app/**/{page,layout,loading,error,not-found,global-error,icon,apple-icon,opengraph-image}.tsx",
      "src/app/**/route.ts",
      "src/app/**/sitemap.ts",
      "src/app/**/robots.ts",
      "src/proxy.ts",
      "src/shared/components/ui/*.tsx",
      "src/styles/globals.css"
    ],
    "project": [
      "src/**/*.{ts,tsx,js,jsx}",
      "packages/**/*.{ts,tsx}",
      "scripts/*.{ts,mjs}",
      "*.{js,ts}"
    ],
    "drizzle": false,
    "ignoreDependencies": [
      "shadcn",
      "markdownlint-cli2",
      "@ast-grep/cli",
      "fallow",
      "lighthouse"
    ],
    "rules": {
      "types": "off"
    },
    "ignoreBinaries": [
      "make"
    ]
  }
}
