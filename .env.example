# Copy this file to ".env" and fill in your values. Do not commit ".env".
# When you add a variable, add it to the schema in src/shared/config/env.js too.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/template_fullstack_t3"

# Honour the x-user-id header as the caller identity (default: false).
# TEMPLATE-TODO(auth): replace header identity with real authentication
TRUST_IDENTITY_HEADER="true"

# Host port for the local PostgreSQL container; change it if 5432 is taken.
POSTGRES_PORT=5432
