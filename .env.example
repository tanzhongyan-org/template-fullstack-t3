# Copy this file to ".env" and fill in your values. Do not commit ".env".
# When you add a variable, add it to src/shared/config/env.js and README.md.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/template_fullstack_t3"

# Direct (non-pooled) connection string for migrations; falls back to DATABASE_URL
# DATABASE_DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/template_fullstack_t3"

# Override Postgres prepared statements (auto-disabled on port 6543 / pgbouncer=true)
# DB_PREPARE_STATEMENTS="true"
# DB_MAX_CONNECTIONS=10

# Honour the x-user-id header as the caller identity (default: false).
# To test /examples during `make dev`, set TRUST_IDENTITY_HEADER="true" in .env.development.local.
# TEMPLATE-TODO(auth): replace header identity in src/server/auth/index.ts with real authentication
TRUST_IDENTITY_HEADER="false"

# Comma-separated user IDs granted the admin role (optional)
# ADMIN_USER_IDS="admin-1"

# Host port for the local PostgreSQL container; change it if 5432 is taken.
POSTGRES_PORT=5432

# Resend API key for transactional email. Unset means console mail in local development only.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Example <noreply@example.com>"

# Server-side PostHog key (dormant when unset).
# POSTHOG_API_KEY="phc_..."
# POSTHOG_HOST="https://us.i.posthog.com"

# Client-side PostHog key for opt-in session replay, heatmaps, and feature flags (dormant when unset).
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# NEXT_PUBLIC_POSTHOG_REPLAY="false"
# NEXT_PUBLIC_POSTHOG_HEATMAPS="false"

# Optional Sentry DSN for server error reporting (dormant when unset).
# SENTRY_DSN="https://key@o0.ingest.sentry.io/0"

# Bearer secret guarding /api/cron/*. Generate one with: openssl rand -hex 32
# CRON_SECRET="..."

# Active payment gateway adapter ("stripe" by default) and webhook secret (503 when unset).
# PAYMENT_PROVIDER="stripe"
# STRIPE_WEBHOOK_SECRET="whsec_..."
