# Copy this file to ".env" and fill in your values. Do not commit ".env".
# When you add a variable, add it to the schema in src/shared/config/env.js too.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/template_fullstack_t3"

# Direct (non-pooled) connection string for migrations; falls back to DATABASE_URL
# DATABASE_DIRECT_URL="postgresql://postgres:password@localhost:5432/template_fullstack_t3"

# Honour the x-user-id header as the caller identity (default: false).
# TEMPLATE-TODO(auth): replace header identity with real authentication
TRUST_IDENTITY_HEADER="true"

# Host port for the local PostgreSQL container; change it if 5432 is taken.
POSTGRES_PORT=5432

# Resend API key for transactional email. Unset means mail prints to the
# console, which only works in local development.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Example <noreply@example.com>"

# PostHog Cloud project key. Unset disables analytics.
# POSTHOG_API_KEY="phc_..."
# POSTHOG_HOST="https://us.i.posthog.com"

# Bearer secret guarding /api/cron/*. Generate one with: openssl rand -hex 32
# CRON_SECRET="..."

# Webhook signing secret for this environment. Unset means the webhook route
# answers 503. Each environment has its own secret.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Turnstile keys for the waitlist form. Unset skips verification locally.
# TURNSTILE_SECRET_KEY="..."
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="..."
