{
  "layout": {
    "allow": [
      ".agents",
      ".ast-grep",
      ".claude",
      ".gemini",
      ".github",
      ".storybook",
      "docs",
      "drizzle",
      "e2e",
      "evals",
      "packages",
      "public",
      "scripts",
      "src"
    ],
    "forbid": [
      "CLAUDE.md",
      "**/CLAUDE.md",
      "CLAUDE.local.md",
      "GEMINI.md",
      "**/GEMINI.md",
      ".cursorrules",
      ".github/copilot-instructions.md"
    ]
  },
  "docs": {
    "exclude": ["docs/plans/**", "docs/specs/**", "docs/archive/**", ".agents/**"],
    "externalPrefixes": ["workflow/", "shared/"],
    "ignorePaths": [".next", ".env", "node_modules", "bun.lock", "next-env.d.ts"],
    "envExample": ".env.example",
    "envDocumentedIn": "README.md"
  },
  "dependencies": {
    "ledger": "docs/dependencies.md",
    "manifests": ["package.json"]
  },
  "versions": [
    {
      "name": "postgres",
      "sources": [
        {
          "file": "compose.yaml",
          "pattern": "image:\\s*postgres:(\\S+)"
        },
        {
          "file": "docker-compose.prod.yml",
          "pattern": "image:\\s*postgres:(\\S+)"
        }
      ]
    }
  ]
}
