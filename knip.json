{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": false,
  "entry": [
    "next.config.js",
    "drizzle.config.ts",
    "scripts/*.{ts,mjs}",
    "src/app/**/{page,layout,loading,error,not-found,route}.tsx",
    "src/app/**/route.ts",
    "src/shared/components/ui/*.tsx",
    "src/styles/globals.css"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}", "scripts/*.{ts,mjs}", "*.{js,ts}"],
  "drizzle": false,
  "ignoreDependencies": ["shadcn", "lucide-react", "markdownlint-cli2", "@ast-grep/cli", "fallow"],
  "rules": {
    "types": "off"
  },
  "ignoreBinaries": ["make"]
}
