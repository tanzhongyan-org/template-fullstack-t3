{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route}.tsx",
    "src/components/ui/*.tsx"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "drizzle": false,
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss",
    "shadcn",
    "lucide-react"
  ],
  "rules": {
    "types": "off"
  }
}
